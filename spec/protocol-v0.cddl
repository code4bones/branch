; B.R.A.N.C.H. draft protocol-v0 CDDL scaffold.
;
; Status: draft scaffold for T-BRANCH-013 only.
; This file does not publish immutable v0 wire semantics. The signed event
; envelope is specified as deterministic CBOR in docs/PROTOCOL_V0.md; the JSON
; shape below mirrors diagnostic fixtures. Payload encryption, session keys, and
; exact frame bytes remain unresolved in docs/OPEN_QUESTIONS.md and must be
; decided before a numbered wire version is declared stable.

branch-draft-envelope = {
  protocol: "branch/connectivity/0",
  event_id: b64url-32,
  type: event-type,
  sender: sender,
  ? recipient_tag: b64url-recipient-tag,
  created_at: draft-timestamp,
  expires_at: draft-timestamp,
  payload_mode: payload-mode,
  payload: b64url-text,
  signature_alg: "ed25519",
  signature: b64url-64,
}

sender = {
  key_alg: "ed25519",
  public_key: b64url-32,
}

event-type =
  "identity.announce" /
  "bootstrap.beacon" /
  "rendezvous.offer" /
  "rendezvous.answer" /
  "route.update" /
  "relay.announce" /
  "capability.grant" /
  "capability.revoke"

payload-mode = "public" / "sealed"

non-empty-text = text .size (1..1024)
b64url-text = non-empty-text
b64url-16 = text .size 22
b64url-32 = text .size 43
b64url-64 = text .size 86
b64url-recipient-tag = b64url-16 / b64url-32

; The draft JSON scaffold is intentionally bounded to the integer range shared
; by Go int64 and TypeScript Number.safeInteger.
draft-timestamp = 0..9007199254740991

branch-draft-profile = {
  schema: "branch.connectivity.profile/0",
  status: "draft",
  published: false,
  decision: "D-BRANCH-026",
  wire_version: 0,
  protocol: "branch/connectivity/0",
  draft_profile_encoding: "json.exact.utf8",
  published_profile_encoding: "cbor.det.rfc8949",
  profile_hash_algorithm: "multihash.sha2-256",
  envelope: {* text => any},
  algorithms: {* text => [* text]},
  events: [* event-type],
  payload_modes: [* payload-mode],
  capabilities: [* text],
  bootstrap_beacon_payload: {* text => any},
  errors: [* text],
  relay_attachment: {* text => any},
  session_frame_contract: {* text => any},
  path_migration_states: [* text],
  relay_boundary: {* text => any},
  required_vector_kinds: [* text],
  publication_blockers: [* text],
  search_carrier_publication: {* text => any},
}

branch-relay-attachment-frame =
  relay-hello /
  relay-challenge /
  relay-auth /
  relay-ready /
  relay-presence /
  relay-heartbeat /
  relay-lookup /
  relay-identity-want /
  relay-identity-have /
  relay-rendezvous /
  relay-envelope /
  relay-ack /
  relay-error

relay-hello = {
  type: "HELLO",
  client_nonce: b64url-32,
  client_time: draft-timestamp,
  requested_role: "relay.forward.live/0",
  max_frame_bytes: 1..49152,
  offers: [1*8 version-offer],
}

relay-challenge = {
  type: "CHALLENGE",
  client_nonce: b64url-32,
  relay_nonce: b64url-32,
  relay_public_key: b64url-32,
  selected: version-offer,
  transcript_hash: b64url-32,
  relay_proof: b64url-64,
}

relay-auth = {
  type: "AUTH",
  client_public_key: b64url-32,
  client_nonce: b64url-32,
  relay_nonce: b64url-32,
  transcript_hash: b64url-32,
  client_proof: b64url-64,
}

relay-ready = {
  type: "READY",
  session_id: b64url-32,
  route_id: b64url-16,
  presence_ttl_seconds: 1..300,
  heartbeat_interval_seconds: 1..60,
  accepted_limits: accepted-limits,
}

relay-presence = {
  type: "PRESENCE",
  session_id: b64url-32,
  route_id: b64url-16,
  peer_id: b64url-32,
  sequence: draft-timestamp,
  ttl_seconds: 1..300,
  sent_at: draft-timestamp,
}

relay-heartbeat = {
  type: "HEARTBEAT",
  session_id: b64url-32,
  sequence: draft-timestamp,
  sent_at: draft-timestamp,
}

relay-lookup = {
  type: "LOOKUP",
  session_id: b64url-32,
  peer_id: b64url-32,
  sequence: draft-timestamp,
}

; BranchID syntax is checked by the protocol parser. The fixed text length
; represents br1. plus a base64url SHA-256 multihash.
branch-id = text .size 50
branch-text-wrapper = text .size (8..8192)

relay-identity-want = {
  type: "IDENTITY_WANT",
  session_id: b64url-32,
  branch_id: branch-id,
  sequence: draft-timestamp,
  hop_limit: 0..4,
}

relay-identity-have = {
  type: "IDENTITY_HAVE",
  session_id: b64url-32,
  branch_id: branch-id,
  sequence: draft-timestamp,
  records: [*4 branch-text-wrapper],
}

relay-rendezvous = {
  type: "RENDEZVOUS",
  session_id: b64url-32,
  route_id: b64url-16,
  peer_id: b64url-32,
  sequence: draft-timestamp,
}

relay-envelope = {
  type: "ENVELOPE",
  session_id: b64url-32,
  route_id: b64url-16,
  origin_route_id: b64url-16,
  path_epoch: draft-timestamp,
  stream_id: draft-timestamp,
  delivery_id: b64url-16,
  ciphertext: b64url-text,
  ack_requested: bool,
}

relay-ack = {
  type: "ACK",
  session_id: b64url-32,
  delivery_id: b64url-16,
  ack_type: "relay.accepted" / "relay.forwarded" / "peer.received",
  durable: false,
}

relay-error = {
  type: "ERROR",
  code: protocol-error-code,
  retryable: bool,
  detail: text .size (1..256),
}

version-offer = {
  wire_version: 0,
  protocol: "branch/connectivity/0",
  profile_multihash: non-empty-text,
  capabilities: [* text],
  required_capabilities: [* text],
  extensions: [* text],
  required_extensions: [* text],
}

accepted-limits = {
  max_frame_bytes: 1..49152,
  max_queue_depth: 1..1024,
  max_frames_per_session: 1..9007199254740991,
  max_bytes_per_session: 1..9007199254740991,
}

protocol-error-code =
  "unsupported_version" /
  "unsupported_profile" /
  "profile_hash_mismatch" /
  "required_capability_missing" /
  "required_extension_missing" /
  "malformed_envelope" /
  "signature_invalid" /
  "payload_decrypt_failed" /
  "frame_too_large" /
  "frame_malformed" /
  "frame_replayed" /
  "authentication_failed" /
  "capability_required" /
  "capability_expired" /
  "capability_revoked" /
  "quota_exceeded" /
  "peer_unavailable" /
  "route_unavailable" /
  "migration_rejected" /
  "rate_limited" /
  "timeout" /
  "internal_unavailable"
