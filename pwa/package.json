{
  "name": "@code4bones/branch-pwa",
  "version": "0.1.0-beta.128",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:core": "test -d ../packages/branch-core/node_modules || npm --prefix ../packages/branch-core ci --prefer-offline --fetch-retries=5 --fetch-retry-maxtimeout=120000 --fetch-timeout=120000",
    "build:core": "npm run prepare:core && npm --prefix ../packages/branch-core run build",
    "build": "npm run build:core && node scripts/build-static.mjs",
    "release": "npm version prerelease --preid=beta --no-git-tag-version && npm run build",
    "typecheck": "npm run build:core && tsc --noEmit",
    "lint": "npm run build:core && eslint .",
    "test": "npm run build:core && tsc -p tsconfig.test.json && node --test \"dist-test/tests/**/*.test.js\""
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@types/node": "24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "esbuild": "^0.25.9",
    "eslint": "9.34.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.41.0"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@code4bones/branch-core": "file:../packages/branch-core",
    "antd": "^5.29.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.18.3",
    "zustand": "^5.0.15"
  }
}
